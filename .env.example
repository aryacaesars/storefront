# =============================================================================
# Storefront — Environment Variables
# =============================================================================
# Copy file ini ke `.env` lalu isi nilainya:
#   cp .env.example .env
#
# Wajib diisi kecuali ditandai (opsional).
# =============================================================================

# -----------------------------------------------------------------------------
# App / Multi-tenant routing
# -----------------------------------------------------------------------------

# Root domain publik TANPA protokol. Dipakai proxy.ts untuk resolve subdomain
# tenant (mis. toko-a.localhost:3000 → tenant "toko-a").
# Prod: domain asli, mis. mystorefront.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Base URL publik app (DENGAN protokol). Dipakai untuk redirect Stripe Checkout
# dan link publish template.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------

# Jalankan Postgres lokal via docker: `docker compose up -d postgres`
# Kredensial default docker-compose.yml: postgres / postgres, db "storefront"
DATABASE_URL=

# -----------------------------------------------------------------------------
# Auth — NextAuth v5 (dashboard builder, login Google)
# -----------------------------------------------------------------------------

# Secret NextAuth. Generate: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth — Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email yang dapat role ADMIN saat login (pisahkan dengan koma).
# Selain daftar ini otomatis dapat role OWNER.
ADMIN_EMAILS=admin@example.com

# -----------------------------------------------------------------------------
# Auth — Customer session (storefront)
# -----------------------------------------------------------------------------

# Min 32 karakter — enkripsi cookie session customer (JWE).
# Generate: `openssl rand -base64 48`
SESSION_SECRET=

# -----------------------------------------------------------------------------
# Storage — MinIO / S3-compatible (asset merchant: logo, hero, produk)
# -----------------------------------------------------------------------------

# Lokal: `docker compose up -d minio` (API :9000, console :9001).
# Nilai di bawah sesuai default docker-compose.yml — langsung jalan untuk dev.
# Prod: ganti dengan endpoint + kredensial S3/R2/MinIO kamu.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=storefront-assets

# URL publik untuk akses balik file yang di-upload.
# Prod: domain CDN / reverse-proxy ke bucket.
S3_PUBLIC_URL=http://127.0.0.1:9000/storefront-assets

# -----------------------------------------------------------------------------
# Payments — Stripe (marketplace template + checkout)
# -----------------------------------------------------------------------------

# Dashboard Stripe → Developers → API keys. Dev pakai sk_test_...
STRIPE_SECRET_KEY=

# Signing secret webhook. Lokal: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# lalu copy nilai whsec_... yang muncul.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Integrasi opsional
# -----------------------------------------------------------------------------
